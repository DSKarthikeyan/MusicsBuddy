<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relativeLayoutNotificationSh"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:layout_margin="@dimen/_4sdp"
    android:background="@color/app_background">

    <ImageView
        android:id="@+id/notificationLogoSh"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/ic_notification" />

    <LinearLayout
        android:id="@+id/linearLayoutRightNotificationViewSh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/notificationLogoSh"
        android:orientation="horizontal"
        android:weightSum="2">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.2">

            <TextView
                android:id="@+id/textNotificationSongNameSh"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_song_name"
                android:textColor="@color/text_notification_color"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/textNotificationAlbumNameSh"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textNotificationSongNameSh"
                android:layout_margin="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_album_name"
                android:textColor="@color/text_notification_color"
                android:textSize="@dimen/_6sdp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight=".8">

            <ImageView
                android:id="@+id/notifyPreviousImageSh"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_toStartOf="@+id/notifyPlayImageSh"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_previous" />

            <ImageView
                android:id="@+id/notifyPlayImageSh"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/notifyNextImageSh"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@+id/notifyPlayImageSh"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_next" />

            <ImageView
                android:id="@+id/notificationCloseSh"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/_2sdp"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

    </LinearLayout>
</RelativeLayout>