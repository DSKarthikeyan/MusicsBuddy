<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relativeLayoutNotification"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_60sdp"
    android:background="@color/app_background">

    <ImageView
        android:id="@+id/notificationLogo"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        android:adjustViewBounds="true"
        android:layout_centerVertical="true"
        android:scaleType="fitXY"
        android:src="@drawable/ic_notification"/>

    <LinearLayout
        android:id="@+id/linearLayoutRightNotificationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_2sdp"
        android:layout_toEndOf="@+id/notificationLogo"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">

            <RelativeLayout
                android:id="@+id/relativeLayoutSongText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_15sdp">

                <TextView
                    android:id="@+id/textNotificationSongName"
                    style="@style/TextAppearance.Compat.Notification.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/text_song_name"
                    android:textColor="@color/text_notification_color"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textNotificationAlbumName"
                    style="@style/TextAppearance.Compat.Notification.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textNotificationSongName"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/text_album_name"
                    android:textColor="@color/text_notification_color"
                    android:textSize="@dimen/_10sdp" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/notificationCloseSh"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/_2sdp"
                android:src="@drawable/ic_close" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/relativeLayoutSongText">

                <ImageView
                    android:id="@+id/notifyPreviousImage"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/_1sdp"
                    android:layout_toStartOf="@+id/notifyPlayImage"
                    android:src="@drawable/ic_previous" />

                <ImageView
                    android:id="@+id/notifyPlayImage"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/ic_play" />

                <ImageView
                    android:id="@+id/notifyNextImage"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/_1sdp"
                    android:layout_toEndOf="@+id/notifyPlayImage"
                    android:src="@drawable/ic_next" />
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>